{
  "name": "portal-meter",
  "version": "0.1.0",
  "private": true,
  "description": "Pay-per-request API settlement on Portaldot V3: EVM settlement + ink! registry",
  "type": "module",
  "exports": {
    ".": "./src/meter.mjs",
    "./session-client": "./src/session-client.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "bin",
    "scripts/lib",
    "deployments",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "contracts/ink/meter_registry/artifact/meter_registry.contract"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 --test-timeout=120000 test/*.test.mjs",
    "status": "node bin/portal-meter.mjs status"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@polkadot/api": "16.5.6",
    "@polkadot/api-contract": "16.5.6",
    "ethers": "6.16.0"
  },
  "bin": {
    "portal-meter": "bin/portal-meter.mjs"
  }
}
